# =============================================================================
# Copie este arquivo para .env e preencha. NUNCA publique o .env no GitHub.
# =============================================================================

# Banco de dados PostgreSQL (Railway, Neon, Supabase, Render...).
DATABASE_URL=postgres://usuario:senha@localhost:5432/invictus
# "disable" só para bancos locais sem SSL. Em produção, deixe em branco (SSL obrigatório).
DATABASE_SSL=

# Endereço público do site, sem barra no final. Em produção, OBRIGATORIAMENTE https://
APP_URL=http://localhost:3000

# Segredo aleatório da aplicação (gere com: openssl rand -hex 32)
APP_SECRET=

# Mercado Pago — "Suas integrações" > sua aplicação > Credenciais.
# Use as credenciais de TESTE durante o desenvolvimento e as de PRODUÇÃO só na publicação.
MP_ACCESS_TOKEN=
# "Suas integrações" > sua aplicação > Webhooks > Assinatura secreta.
MP_WEBHOOK_SECRET=

# Segredo da rotina de conciliação (/api/cron/reconcile). Gere com: openssl rand -hex 32
CRON_SECRET=

# Somente para testes automatizados (servidor simulado). NÃO defina em produção.
# MP_API_BASE_URL=http://127.0.0.1:4010
